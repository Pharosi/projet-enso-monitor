# Configuration de production : copier en .env sur le serveur (jamais versionné).
#   cp .env.example .env && chmod 600 .env

# Nom de domaine pointant vers le VPS (enregistrement DNS A/AAAA).
# Pour une démonstration locale : DOMAINE=localhost (certificat auto-signé par Caddy).
DOMAINE=enso.exemple.fr
EMAIL_ACME=contact@exemple.fr

# Base de données. Générer le mot de passe avec : openssl rand -hex 24
# (caractères hexadécimaux uniquement : il est inséré dans l'URL de connexion).
POSTGRES_USER=enso
POSTGRES_PASSWORD=a-generer
POSTGRES_DB=enso
