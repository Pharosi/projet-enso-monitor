# Copier ce fichier en .env puis adapter les valeurs.
# Le fichier .env n'est jamais versionné (voir .gitignore).

# --- PostgreSQL (lu par Docker Compose) ---
POSTGRES_USER=enso
POSTGRES_PASSWORD=changer-ce-mot-de-passe
POSTGRES_DB=enso

# --- API et ETL (lus par enso/config.py) ---
URL_BASE_DE_DONNEES=postgresql+psycopg://enso:changer-ce-mot-de-passe@localhost:5432/enso

# Facultatif : fichier ONI à importer (valeur par défaut : fichier officiel NOAA CPC)
# URL_FICHIER_ONI=https://www.cpc.ncep.noaa.gov/data/indices/oni.ascii.txt
